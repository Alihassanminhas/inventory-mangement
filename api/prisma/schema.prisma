generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  ADMIN
  MANAGER
  STAFF
}

enum MovementType {
  PURCHASE_RECEIPT
  SALE
  INCREASE
  DECREASE
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
}

enum PurchaseStatus {
  DRAFT
  ORDERED
  RECEIVED
  CANCELLED
}

enum SalesStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

model User {
  id           String          @id @default(cuid())
  email        String          @unique
  name         String
  passwordHash String
  role         Role            @default(STAFF)
  createdAt    DateTime        @default(now())
  movements    StockMovement[]
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
}

model Product {
  id             String          @id @default(cuid())
  sku            String          @unique
  name           String
  description    String?
  imageUrl       String?
  price          Decimal         @db.Decimal(12, 2)
  cost           Decimal         @default(0) @db.Decimal(12, 2)
  reorderLevel   Int             @default(10)
  categoryId     String?
  category       Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  inventory      Inventory[]
  movements      StockMovement[]
  purchaseItems  PurchaseItem[]
  salesItems     SalesItem[]
}

model Warehouse {
  id            String          @id @default(cuid())
  name          String          @unique
  location      String?
  createdAt     DateTime        @default(now())
  inventory     Inventory[]
  movements     StockMovement[]
  purchaseOrders PurchaseOrder[]
  salesOrders   SalesOrder[]
}

model Inventory {
  id          String    @id @default(cuid())
  productId   String
  warehouseId String
  available   Int       @default(0)
  reserved    Int       @default(0)
  damaged     Int       @default(0)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@unique([productId, warehouseId])
  @@index([warehouseId])
}

// Immutable audit rows: stock services append rows and never update/delete them.
model StockMovement {
  id          String       @id @default(cuid())
  productId   String
  warehouseId String
  type        MovementType
  delta       Int
  before      Int
  after       Int
  reference   String?
  actorId     String
  createdAt   DateTime     @default(now())
  product     Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse   Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  actor       User         @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([productId, createdAt])
  @@index([warehouseId, createdAt])
  @@index([actorId, createdAt])
}

model Supplier {
  id        String          @id @default(cuid())
  name      String
  email     String?
  orders    PurchaseOrder[]
  createdAt DateTime        @default(now())
}

model Customer {
  id        String       @id @default(cuid())
  name      String
  email     String?
  orders    SalesOrder[]
  createdAt DateTime     @default(now())
}

model PurchaseOrder {
  id          String         @id @default(cuid())
  supplierId  String
  warehouseId String
  status      PurchaseStatus @default(ORDERED)
  total       Decimal        @db.Decimal(14, 2)
  createdAt   DateTime       @default(now())
  supplier    Supplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  warehouse   Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  items       PurchaseItem[]

  @@index([supplierId, createdAt])
  @@index([warehouseId, status])
}

model PurchaseItem {
  id        String        @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  unitCost  Decimal       @db.Decimal(12, 2)
  order     PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([productId])
}

model SalesOrder {
  id          String       @id @default(cuid())
  customerId  String?
  warehouseId String
  status      SalesStatus  @default(DRAFT)
  total       Decimal      @db.Decimal(14, 2)
  createdAt   DateTime     @default(now())
  customer    Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  warehouse   Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  items       SalesItem[]

  @@index([customerId, createdAt])
  @@index([warehouseId, status])
}

model SalesItem {
  id        String     @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  unitPrice Decimal    @db.Decimal(12, 2)
  order     SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product    @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([productId])
}
